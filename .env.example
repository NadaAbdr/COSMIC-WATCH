# Copy this file to .env and fill in the values. NEVER commit .env.
NASA_API_KEY=your_nasa_api_key

# PostgreSQL (docker-compose reads these too)
POSTGRES_DB=cosmic_watch
POSTGRES_USER=cosmic
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google Cloud (only needed for the BigQuery copy)
GCP_PROJECT=cosmic-watch-de
BQ_DATASET=your_bigquery_dataset
